[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/27/2026,0.3.1.0
CatalogFile=VirtualDialDriver.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299,NTarm64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceName%=Install,Root\VirtualDialVHF

[Models.NTarm64.10.0...16299]
%DeviceName%=Install,Root\VirtualDialVHF

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
VirtualDialDriver.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
VirtualDialDriver.sys

[Install.NT.Services]
AddService=VirtualDialDriver,0x00000002,Service

[Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VirtualDialDriver.sys

[Install.NT.HW]
AddReg=VhfLowerFilter

[VhfLowerFilter]
HKR,,LowerFilters,0x00010000,"vhf"

[Install.NT.Wdf]
KmdfService=VirtualDialDriver,Kmdf

[Kmdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="VirtualDial Development"
DeviceName="Virtual Dial VHF Source"
DiskName="VirtualDial installation disk"


